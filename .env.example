# Postgres connection (matches docker-compose.yml default)
DATABASE_URL=postgres://pi:pi@localhost:5432/pikanban

# Token that pi plugins present in their `hello` message
AGENT_TOKEN=change-me-agent-token

# Token for the web dashboard (Bearer header / ?token= query param)
ADMIN_TOKEN=change-me-admin-token

# HTTP + WS + SSE port for the server
PORT=8787
