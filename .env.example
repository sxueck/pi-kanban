# Postgres connection (matches docker-compose.yml default)
DATABASE_URL=postgres://pi:pi@localhost:5432/pikanban

# Bootstrap-only secret for creating the first administrator account.
# It is not used for normal dashboard login or pi plugin connections.
ADMIN_TOKEN=change-me-bootstrap-token

# HTTP + WS + SSE port for the server
PORT=8787

# Encrypts the global model API key stored in Postgres. Use a stable random
# value with at least 32 characters; changing it requires re-entering the key.
MODEL_SETTINGS_SECRET=replace-with-a-stable-random-secret-at-least-32-chars
